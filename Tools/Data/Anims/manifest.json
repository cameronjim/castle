{
  "version": 1,
  "about": "Combat clips for Tools/Editor/import_combat_anims.py. See Tools/Data/Anims/README.md for the shopping list and claude-docs/animation.md for the pipeline. Windows are fractions of a clip's length; leave them out to take the role defaults in import_combat_anims.py.",

  "targets": {
    "uefn": {
      "skeletal_mesh": "/Game/Characters/UEFN_Mannequin/Meshes/SKM_UEFN_Mannequin",
      "ik_rig": "/Game/Characters/UEFN_Mannequin/Rigs/IK_UEFN_Mannequin",
      "ik_rig_from_gasp": "Characters/UEFN_Mannequin/Rigs/IK_UEFN_Mannequin.uasset",
      "chains": "uefn",
      "output": "/Game/Characters/UEFN_Mannequin/Animations/Combat",
      "characters": ["kate", "clint"],
      "root_motion": true
    },
    "thug": {
      "skeletal_mesh": "/Game/Mannequin/Character/Mesh/SK_Mannequin",
      "ik_rig": "/Game/Mannequin/Animations/Combat/Rigs/IK_Thug_Mannequin",
      "chains": "ue4",
      "output": "/Game/Mannequin/Animations/Combat",
      "characters": ["thug", "archer"],
      "root_motion": false
    }
  },

  "chain_maps": {
    "mixamo": {
      "about": "Mixamo's rig. Bone names are matched with or without the mixamorig: (or mixamorig_, mixamorig1:) prefix the FBX importer may keep. No root bone: root motion is generated from the hips.",
      "retarget_root": "Hips",
      "root_bone": "",
      "chains": {
        "Spine": ["Spine", "Spine2"],
        "Neck": ["Neck", "Neck"],
        "Head": ["Head", "Head"],
        "LeftClavicle": ["LeftShoulder", "LeftShoulder"],
        "LeftArm": ["LeftArm", "LeftHand"],
        "LeftThumb": ["LeftHandThumb1", "LeftHandThumb3"],
        "LeftIndex": ["LeftHandIndex1", "LeftHandIndex3"],
        "LeftMiddle": ["LeftHandMiddle1", "LeftHandMiddle3"],
        "LeftRing": ["LeftHandRing1", "LeftHandRing3"],
        "LeftPinky": ["LeftHandPinky1", "LeftHandPinky3"],
        "RightClavicle": ["RightShoulder", "RightShoulder"],
        "RightArm": ["RightArm", "RightHand"],
        "RightThumb": ["RightHandThumb1", "RightHandThumb3"],
        "RightIndex": ["RightHandIndex1", "RightHandIndex3"],
        "RightMiddle": ["RightHandMiddle1", "RightHandMiddle3"],
        "RightRing": ["RightHandRing1", "RightHandRing3"],
        "RightPinky": ["RightHandPinky1", "RightHandPinky3"],
        "LeftLeg": ["LeftUpLeg", "LeftFoot"],
        "LeftToe": ["LeftToeBase", "LeftToeBase"],
        "RightLeg": ["RightUpLeg", "RightFoot"],
        "RightToe": ["RightToeBase", "RightToeBase"]
      }
    },
    "ue4": {
      "about": "The UE4 mannequin, which Paragon heroes share (Sparrow_Skeleton: root, pelvis, spine_01-03, neck_01, head, clavicle, upperarm to hand, three-joint fingers, thigh to foot, ball).",
      "retarget_root": "pelvis",
      "root_bone": "root",
      "chains": {
        "Root": ["root", "root"],
        "Spine": ["spine_01", "spine_03"],
        "Neck": ["neck_01", "neck_01"],
        "Head": ["head", "head"],
        "LeftClavicle": ["clavicle_l", "clavicle_l"],
        "LeftArm": ["upperarm_l", "hand_l"],
        "LeftThumb": ["thumb_01_l", "thumb_03_l"],
        "LeftIndex": ["index_01_l", "index_03_l"],
        "LeftMiddle": ["middle_01_l", "middle_03_l"],
        "LeftRing": ["ring_01_l", "ring_03_l"],
        "LeftPinky": ["pinky_01_l", "pinky_03_l"],
        "RightClavicle": ["clavicle_r", "clavicle_r"],
        "RightArm": ["upperarm_r", "hand_r"],
        "RightThumb": ["thumb_01_r", "thumb_03_r"],
        "RightIndex": ["index_01_r", "index_03_r"],
        "RightMiddle": ["middle_01_r", "middle_03_r"],
        "RightRing": ["ring_01_r", "ring_03_r"],
        "RightPinky": ["pinky_01_r", "pinky_03_r"],
        "LeftLeg": ["thigh_l", "foot_l"],
        "LeftToe": ["ball_l", "ball_l"],
        "RightLeg": ["thigh_r", "foot_r"],
        "RightToe": ["ball_r", "ball_r"]
      }
    },
    "uefn": {
      "about": "The UEFN and UE5 mannequins (five spine bones, two neck bones, metacarpals). Only used when IK_UEFN_Mannequin cannot be copied from the Game Animation Sample, and for the self-test's UE5 source.",
      "retarget_root": "pelvis",
      "root_bone": "root",
      "chains": {
        "Root": ["root", "root"],
        "Spine": ["spine_01", "spine_05"],
        "Neck": ["neck_01", "neck_02"],
        "Head": ["head", "head"],
        "LeftClavicle": ["clavicle_l", "clavicle_l"],
        "LeftArm": ["upperarm_l", "hand_l"],
        "LeftThumb": ["thumb_01_l", "thumb_03_l"],
        "LeftIndex": ["index_01_l", "index_03_l"],
        "LeftMiddle": ["middle_01_l", "middle_03_l"],
        "LeftRing": ["ring_01_l", "ring_03_l"],
        "LeftPinky": ["pinky_01_l", "pinky_03_l"],
        "RightClavicle": ["clavicle_r", "clavicle_r"],
        "RightArm": ["upperarm_r", "hand_r"],
        "RightThumb": ["thumb_01_r", "thumb_03_r"],
        "RightIndex": ["index_01_r", "index_03_r"],
        "RightMiddle": ["middle_01_r", "middle_03_r"],
        "RightRing": ["ring_01_r", "ring_03_r"],
        "RightPinky": ["pinky_01_r", "pinky_03_r"],
        "LeftLeg": ["thigh_l", "foot_l"],
        "LeftToe": ["ball_l", "ball_l"],
        "RightLeg": ["thigh_r", "foot_r"],
        "RightToe": ["ball_r", "ball_r"]
      }
    }
  },

  "sources": [
    {
      "name": "Mixamo",
      "kind": "mixamo_fbx",
      "path": "Tools/Data/Anims/Mixamo",
      "chains": "mixamo",
      "mesh_file": "Mixamo_Skin.fbx",
