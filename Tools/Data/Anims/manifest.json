    },
    {
      "name": "ParagonSparrow",
      "kind": "uasset_project",
      "path": "C:/Users/camer/code/GASP/Content",
      "path_env": "HAWKEYE_SPARROW_CONTENT",
      "skeletal_mesh": "/Game/ParagonSparrow/Characters/Heroes/Sparrow/Meshes/Sparrow",
      "chains": "ue4",
      "about": "Epic's free Paragon: Sparrow pack from Fab, added to a project whose Content folder is path (it lives in the Game Animation Sample's). The clips, the skeleton and the mesh (with its materials, about 730 MB) are copied to the same /Game/ParagonSparrow paths here, git-ignored."
    }
  ],

